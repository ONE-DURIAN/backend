# Go App Port
APP_PORT=<port>

# Data Node Connection (192.168.1.202)
DB_HOST=<IP-ADDRESS>
DB_PORT=
DB_USER=<username>
DB_PASSWORD=<password>
DB_NAME=<db-name>

REDIS_HOST=<ip-address>
REDIS_PORT=<port>
REDIS_PASSWORD=<password>

# Garage S3 Credentials
S3_ENDPOINT=http://[IP-ADDRESS]
S3_REGION=garage
S3_ACCESS_KEY=<key-id>
S3_SECRET_KEY=<secret-key>
S3_BUCKET=<name-bucket>

# Cloudflare Tunnel Token (นำมาจาก Cloudflare Zero Trust Dashboard)
CLOUDFLARE_TUNNEL_TOKEN=<token>

# JWT Secret & Expiration
JWT_SECRET=<your-super-secret-jwt-key>
JWT_ACCESS_EXPIRATION_HOURS=2
JWT_REFRESH_EXPIRATION_DAYS=30